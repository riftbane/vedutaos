#!/bin/sh
# The card is the volume labelled VEDUTA when one is plugged in (a USB stick, or the disk
# QEMU shows the machine), else the boot partition. Either way it is seen at
# /boot/firmware, and its vedutaos/authorized_keys admits ssh as the user veduta.
set -e
card=/boot/firmware
if dev=$(readlink -f /dev/disk/by-label/VEDUTA 2>/dev/null) && [ -b "$dev" ]; then
	mount -o ro "$dev" "$card" && echo "card: $dev on $card"
else
	echo "card: the boot partition"
fi
keys=$card/vedutaos/authorized_keys
if [ -r "$keys" ]; then
	install -d -m 0700 -o veduta -g veduta /home/veduta/.ssh
	install -m 0600 -o veduta -g veduta "$keys" /home/veduta/.ssh/authorized_keys
	echo "card: ssh keys installed"
fi
