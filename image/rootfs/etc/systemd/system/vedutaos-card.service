[Unit]
Description=VedutaOS card: a volume labelled VEDUTA, else the boot partition
DefaultDependencies=no
After=local-fs.target systemd-udev-settle.service
Wants=systemd-udev-settle.service
Before=ssh.service vedutaos.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/vedutaos/card

[Install]
WantedBy=multi-user.target
